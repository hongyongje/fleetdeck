{
  "name": "fleetdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IoT device fleet monitoring and signed OTA update template",
  "license": "MIT",
  "engines": { "node": ">=22.6" },
  "scripts": {
    "keygen": "node tools/keygen.ts",
